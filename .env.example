# Copie para .env e troque as senhas. O .env nunca vai para o git.
# Sem .env, o docker compose usa valores padrão que servem só para desenvolvimento.

POSTGRES_DB=lumio
POSTGRES_USER=lumio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
REDIS_PORT=6379

# Papéis usados pelos serviços (criados pelo serviço migrate)
LUMIO_APP_DB_PASSWORD=troque-esta-senha-tambem
LUMIO_SYSTEM_DB_PASSWORD=e-esta-tambem

# Dias de leituras ópticas/saúde guardados (alarmes não são apagados)
LUMIO_RETENTION_DAYS=90
