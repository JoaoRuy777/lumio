# Copie para .env e troque as senhas. O .env nunca vai para o git.
# Sem .env, o docker compose usa valores padrão que servem só para desenvolvimento.

POSTGRES_DB=lumio
POSTGRES_USER=lumio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
REDIS_PORT=6379

# Papéis usados pelos serviços (criados pelo serviço migrate)
LUMIO_APP_DB_PASSWORD=troque-esta-senha-tambem
LUMIO_SYSTEM_DB_PASSWORD=e-esta-tambem

# Dias de leituras ópticas/saúde guardados (alarmes não são apagados)
LUMIO_RETENTION_DAYS=90

# API (sprint 3)
# Segredo dos tokens de login: no mínimo 32 caracteres aleatórios
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LUMIO_JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# Chave que cifra a community SNMP no banco. Se mudar, as communities salvas
# deixam de abrir (cadastre de novo). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LUMIO_SECRET_KEY=gere-uma-chave-fernet
# Token que o coletor usa para ler o cadastro de OLTs na API
LUMIO_SERVICE_TOKEN=troque-por-outro-segredo-aleatorio

# Notificações (sprint 5)
# Endereço público do painel (vai nos e-mails e webhooks)
LUMIO_PUBLIC_URL=https://lumio.seudominio.com.br
# SMTP de produção (ex.: Brevo, Amazon SES, Resend, Gmail com senha de app)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASSWORD=sua-senha-smtp
SMTP_FROM=Lumio <alertas@seudominio.com.br>
# starttls (porta 587), tls (porta 465) ou none (só desenvolvimento)
SMTP_SECURITY=starttls
# NUNCA true em produção: deixaria webhooks acessarem a rede interna (SSRF)
LUMIO_WEBHOOK_ALLOW_PRIVATE=false

# Assistente de IA (Google Gemini; chave grátis em aistudio.google.com). Sem ela, o assistente fica desligado.
# Dados pessoais de clientes são anonimizados antes de sair para o Google.
GEMINI_API_KEY=
# opcional: modelos em ordem de preferência
# LUMIO_AI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest
