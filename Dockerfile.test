# Imagem só para rodar a suíte de testes: docker compose run --rm tests
FROM python:3.12-slim
WORKDIR /src
COPY requirements-dev.txt .
COPY simulator/requirements.txt simulator/
COPY collector/requirements.txt collector/
COPY worker/requirements.txt worker/
COPY db/requirements.txt db/
COPY api/requirements.txt api/
RUN pip install --no-cache-dir -r requirements-dev.txt
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["pytest", "-v", "-p", "no:cacheprovider"]
